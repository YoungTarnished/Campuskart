PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/campuskart
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Local demo only. Never enable this in production.
# When true (or when NODE_ENV is not production), verification and reset
# tokens are returned by the API instead of being emailed.
DEMO_VERIFICATION=true

# Optional. When all three are set, uploads go to Cloudinary.
# Otherwise images are stored in backend/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Student emails are fixed to [iit|iib|ice|msb]202X[XXX]@iiita.ac.in.
# Admin sign-in is limited to tarang, dhairya, and lakshya @iiita.ac.in.
